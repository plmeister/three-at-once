# dependencies
node_modules/

# build output — `npm run build` regenerates this; the Dockerfile builds it itself
dist/

# runtime cache (server/cache.mjs, only when CACHE_DB points at a local path)
*.db
*.db-journal
*.sqlite
*.sqlite3

# search index: the .gz seed is committed, the raw .json and any temp build are not
server/search-index.json
server/*.gz.tmp

# downloaded NaPTAN/NPTG datasets (build-index.mjs cache)
/data/

# logs / editor / OS noise
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/
*.swp

# local env overrides (never commit real ones)
.env
.env.*
!.env.example